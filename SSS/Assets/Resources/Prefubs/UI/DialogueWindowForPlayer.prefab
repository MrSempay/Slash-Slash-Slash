  m_text: "\u042D\u0442\u043E \u0432\u0442\u043E\u0440\u0430\u044F, \u043D\u0430
    \u043C\u043E\u0439 \u0432\u0437\u0433\u043B\u044F\u0434 \u043F\u043E\u043B\u0443\u0447\u0448\u0435
    \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C:\r\n\u0412\u0430\u0448
    \u0442\u0435\u043A\u0441\u0442 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0441\u043C\u0435\u0441\u044C \u043C\u0438\u0444\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u0432\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F,
    \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432 \u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432
    \u0444\u044D\u043D\u0442\u0435\u0437\u0438. \u041E\u043D \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0439 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043E\u0439
    \u0438 \u0441\u0442\u0438\u043B\u0438\u0441\u0442\u0438\u043A\u043E\u0439, \u043D\u043E
    \u0442\u0430\u043A\u0436\u0435 \u0438\u043C\u0435\u0435\u0442 \u0440\u044F\u0434
    w\r\n\r"
